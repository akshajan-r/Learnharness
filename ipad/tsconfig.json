{
	"extends": "../tsconfig.json",
	"compilerOptions": {
		"types": [
			"node"
		],
		"plugins": [],
		"incremental": false,
		"paths": {
			"@/*": [
				"../*"
			]
		},
		"typeRoots": [
			"../node_modules/@types"
		]
	},
	"include": [
		"src/**/*.ts",
		"src/**/*.tsx",
		"vite.config.ts",
		"capacitor.config.ts"
	],
	"exclude": [
		"node_modules",
		"dist",
		"ios"
	]
}
